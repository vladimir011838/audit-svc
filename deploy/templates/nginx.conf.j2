# {{ ansible_managed }}

# основной порт: единственный вход к сервису
server {
    listen 8080;

    # DNS Docker: имя сервиса резолвится заново (valid=10s), а не один раз при старте.
    # Иначе после пересоздания контейнера сервиса (новый IP) Nginx отвечал бы 502.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $audit_svc http://{{ audit_svc_container }}:8080;

    # /reload закрыт снаружи. location сравнивается с нормализованным путём:
    # %72eload -> reload, //reload -> /reload, ?x=1 отбрасывается
    location = /reload {
        return 404;
    }
    location ^~ /reload/ {
        return 404;
    }

    location / {
        proxy_pass $audit_svc;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

# служебный порт: stub_status для nginx-exporter, наружу не публикуется
server {
    listen 8081;

    location = /stub_status {
        stub_status;
    }
    location / {
        return 404;
    }
}
